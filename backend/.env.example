# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/classpulse?sslmode=require

# Set to false only if your provider uses a self-signed certificate.
DB_SSL_REJECT_UNAUTHORIZED=true

# Redis (Upstash Redis connection string)
REDIS_URL=redis://default:password@example.upstash.io:6379

# Auth & Security
JWT_SECRET=your_super_secret_jwt_key_here
QR_HMAC_SECRET=your_super_secret_hmac_key_here
# Optional, defaults to JWT_SECRET. Used to derive anonymous forum pseudonyms.
PSEUDONYM_SECRET=

# Teacher self-signup invite code. Required in production to enable teacher
# signup; leave unset to disable teacher self-signup there.
TEACHER_INVITE_CODE=

# Comma-separated list of browser origins allowed by CORS (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# Rate limiting (requests per window)
# Per-email login attempts and per-IP login attempts are counted separately so
# that one throttled account does not block a shared campus NAT, and a class of
# students behind one IP does not hit the per-IP cap.
AUTH_LOGIN_EMAIL_RATE_LIMIT_MAX=10
AUTH_LOGIN_IP_RATE_LIMIT_MAX=100
AUTH_SIGNUP_RATE_LIMIT_MAX=50
SEARCH_RATE_LIMIT_MAX=60

# Attendance sessions older than this are auto-ended.
SESSION_MAX_HOURS=4

# Live activities only link to an attendance session that ended within this window.
ATTENDANCE_LINK_WINDOW_HOURS=12

# Email delivery for low-attendance warnings. Configure ONE primary provider:
# Brevo (recommended), Resend, or SMTP. With none configured, emails are simulated.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Set to false only for a self-signed SMTP development server.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Server Configuration
PORT=4000
NODE_ENV=development
